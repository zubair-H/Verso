{
  "expo": {
    "name": "LOOKR",
    "slug": "lookr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lookr",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lookr.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "LOOKR needs access to your photos to try looks on yourself.",
        "NSCameraUsageDescription": "LOOKR needs access to your camera to take selfies."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.lookr.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "LOOKR needs access to your photos to try looks on yourself.",
          "cameraPermission": "LOOKR needs access to your camera to take selfies."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
