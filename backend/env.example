# Celebrity Attribute Transfer API Configuration

# Port for the server (default: 4000)
PORT=4000

# Google AI Studio - Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Replicate API Token
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# Fast hair version (optional override)
REPLICATE_FAST_HAIR_VERSION=

# Eye edit model slug (optional override)
REPLICATE_EYE_EDIT_MODEL=black-forest-labs/flux-kontext-pro

# New model slugs for analysis/edit pipeline
REPLICATE_INPAINTING_MODEL=stability-ai/stable-diffusion-inpainting
REPLICATE_FACE_PARSING_MODEL=fermatresearch/bisenet-faces
REPLICATE_CLOTHING_SEG_MODEL=mattmdjaga/segformer-b2-clothes
REPLICATE_SAM2_MODEL=meta/sam-2
# Optional alternate hair segmentation model slug for fallback quality
REPLICATE_HAIR_SEG_MODEL=

# Session TTL in minutes
SESSION_TTL_MINUTES=30
